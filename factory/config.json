{
  "base_branch": "main",
  "merge_method": "merge",
  "concurrency": 3,
  "max_rounds": 3,
  "checks": ["python factory/test_factory.py"],
  "labels": {
    "queue": "factory",
    "needs_info": "factory:needs-info",
    "needs_human": "factory:needs-human"
  },
  "routing": {
    "low": { "code": "haiku" },
    "medium": { "code": "sonnet" },
    "high": { "code": "sonnet" }
  },
  "surface_reviewers": {
    "ui": { "ux": "sonnet", "ui": "haiku" },
    "security": { "security": "opus" }
  },
  "protected_paths": [
    "factory/factory.py",
    "factory/config.json",
    ".claude/skills/factory/*",
    ".claude/agents/intake.md",
    ".claude/agents/spec-writer.md",
    ".claude/agents/builder.md",
    ".claude/agents/approver.md",
    ".claude/agents/reviewer-*.md"
  ],
  "ports": { "base": 5100, "step": 10 },
  "prices_usd_per_mtok": {
    "fable": { "input": 10.0, "output": 50.0, "cache_write_5m": 12.5, "cache_write_1h": 20.0, "cache_read": 0.25 },
    "opus": { "input": 4.0, "output": 20.0, "cache_write_5m": 5.0, "cache_write_1h": 8.0, "cache_read": 0.20 },
    "sonnet": { "input": 2.0, "output": 10.0, "cache_write_5m": 2.5, "cache_write_1h": 4.0, "cache_read": 0.20 },
    "haiku": { "input": 0.10, "output": 0.50, "cache_write_5m": 0.125, "cache_write_1h": 0.20, "cache_read": 0.01 }
  }
}
